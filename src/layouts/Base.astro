---
import "../styles/global.css";
import Preloader from "../components/Preloader.tsx";
import SmoothScroll from "../components/SmoothScroll.astro";
import LanguageGate from "../components/LanguageGate.tsx";
import TurnstileGuard from "../components/TurnstileGuard.tsx";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  /** Alt text for the social preview image. Defaults to the page title. */
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Personal / private pages can opt out of search indexing. */
  noindex?: boolean;
}
const {
  title = "Phumitch Somsri · Guitar | Vibe Coding Full-stack",
  description = "Expert in prompting AI to build production websites · Vibe Coding ◆ Full-stack · Zexta Studio",
  ogImage = "/works/zexta.avif",
  ogImageAlt,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  noindex = false,
} = Astro.props;

/* /verify shows its own full-page dialog — the intro overlays would sit on top of it. */
const isVerify = /^\/verify\/?$/.test(Astro.url.pathname);
/* /admin is its own authenticated app — the intro overlays block the dashboard. */
const isAdmin = /^\/admin\/?$/.test(Astro.url.pathname);

/* Absolute URLs are required by Open Graph / Twitter cards and preferred by
   search engines for canonical + og:url. */
const siteOrigin = Astro.site ?? new URL("https://phumitch.space/");
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = new URL(ogImage, siteOrigin).href;
const socialImageAlt = ogImageAlt ?? title;
---

<html lang="th" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <meta name="description" content={description} />
    <meta name="keywords" content={Astro.props.keywords || "Graphic design, web development, Discord bots, Thai developer, Phumitch Somsri"} />
    <meta name="author" content="Phumitch Somsri" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:site_name" content="phumitch.space" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:locale:alternate" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/zt-icon.png" />

    <!-- Prefetch/DNS hints for the live data fetch on the portfolio page -->
    <link rel="dns-prefetch" href="https://bzdsqdorqpwjkdioopzk.supabase.co" />
    <link rel="preconnect" href="https://bzdsqdorqpwjkdioopzk.supabase.co" crossorigin />

    <!-- Turnstile is only fetched when the gate actually shows (see TurnstileChallenge.tsx) -->
    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />

    <title>{title}</title>

    <!-- Person schema — gives Google's AI a clean, citable answer to "นายภูมิทัศน์ สมศรี คือใคร?" -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Phumitch Somsri",
        "alternateName": ["Guitar", "phumitchreal", "นายภูมิทัศน์ สมศรี"],
        "jobTitle": ["Full-stack Developer", "นักพัฒนาเว็บ Full-stack", "Graphic Designer"],
        "birthDate": "1994-08-11",
        "gender": "Male",
        "nationality": "Thai",
        "url": "https://phumitch.space/",
        "email": "phumithasnsmsri2@gmail.com",
        "sameAs": [
          "https://github.com/phumitchreal",
          "https://instagram.com/null_phumitch",
          "https://discord.com/users/919878532228841532",
          "https://phumitch.space"
        ]
      }
    </script>

    <script is:inline data-astro-rerun>
      (function () {
        document.documentElement.classList.add("js");
        try {
          // Light is the default theme; a stored choice always wins.
          var stored = localStorage.getItem("theme");
          var theme = stored === "dark" ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", theme);

          var lang = localStorage.getItem("crinoid_lang");
          if (lang === "th" || lang === "en") document.documentElement.lang = lang;
        } catch (_) {}
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <Preloader client:load enabled={!isVerify && !isAdmin} />
    <LanguageGate client:load enabled={!isVerify && !isAdmin} />
    <TurnstileGuard client:load />
    <div class="relative z-10">
      <slot />
    </div>

    <!-- Reference-style blur rise on scroll for server-rendered sections -->
    <script is:inline data-astro-rerun>
      (function () {
        var els = document.querySelectorAll("[data-reveal]");
        if (!els.length) return;
        if (!("IntersectionObserver" in window)) {
          els.forEach(function (el) { el.classList.add("is-revealed"); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-revealed");
              io.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>

    <SmoothScroll />
  </body>
</html>
