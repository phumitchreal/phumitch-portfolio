---
import "../styles/global.css";
import Preloader from "../components/Preloader.tsx";
import LanguageGate from "../components/LanguageGate.tsx";
import TurnstileGuard from "../components/TurnstileGuard.tsx";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = "Phumitch Somsri · Guitar | Vibe Coding Full-stack",
  description = "Expert in prompting AI to build production websites · Vibe Coding ◆ Full-stack · Zexta Studio",
  ogImage = "/zt-icon.png",
} = Astro.props;

/* Cloudflare Turnstile sitekey — public by design. Empty ⇒ the gate stays inert. */
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";

/* /verify shows its own full-page dialog — the intro overlays would sit on top of it. */
const isVerify = /^\/verify\/?$/.test(Astro.url.pathname);
---

<html lang="th" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafbfc" media="(prefers-color-scheme: light)" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- RABBIT is self-hosted — preload the two weights used in first paint -->
    <link rel="preload" href="/fonts/rabbit-regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/rabbit-bold.otf" as="font" type="font/otf" crossorigin />

    <!-- Turnstile is only fetched when the gate actually shows (see TurnstileChallenge.tsx) -->
    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />

    <title>{title}</title>

    <script is:inline data-astro-rerun>
      (function () {
        try {
          // Dark is the default theme (DESIGN.md); a stored choice always wins.
          var stored = localStorage.getItem("theme");
          var theme = stored === "light" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", theme);

          var lang = localStorage.getItem("crinoid_lang");
          if (lang === "th" || lang === "en") document.documentElement.lang = lang;
        } catch (_) {}
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">ข้ามไปที่เนื้อหา / Skip to content</a>
    <Preloader client:load enabled={!isVerify} />
    <LanguageGate client:load enabled={!isVerify} />
    <TurnstileGuard client:load />
    <slot />
  </body>
</html>
