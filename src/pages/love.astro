---
/**
 * A little page made for one person. 💌
 *
 * เนื้อหาทั้งหมดดึงจาก Supabase (portfolio_profile.data.girlfriend.love)
 * แก้ได้จากหน้า /admin แท็บ "แฟน" — ไม่ต้องแก้โค้ด
 */
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import BackHome from "../components/BackHome.astro";
import { getProfile } from "../lib/portfolioData.ts";

const profile = await getProfile();
const { love } = profile.girlfriend;

const hero = love.hero;
const reasons = love.reasons;
const moments = love.moments;
const letter = love.letter;
const closing = love.closing;

/* floating hearts: x position %, size px, delay s, duration s */
const hearts = [
  { x: 8, s: 16, d: 0, t: 9 },
  { x: 18, s: 10, d: 2.2, t: 11 },
  { x: 31, s: 20, d: 1.1, t: 10 },
  { x: 44, s: 12, d: 3.4, t: 12 },
  { x: 57, s: 18, d: 0.6, t: 9.5 },
  { x: 68, s: 11, d: 2.8, t: 11.5 },
  { x: 79, s: 22, d: 1.6, t: 10.5 },
  { x: 90, s: 13, d: 3.9, t: 12.5 },
];
---

<Base
  title="สำหรับเธอ · For you | phumitch.space"
  description="A small page made with love — for one person only."
  ogImage="/works/zexta.avif"
  noindex
>
  <div class="love-page relative flex min-h-screen flex-col overflow-x-clip text-fg-body">
    <SiteNav />

    <main id="main" class="relative z-10 flex-1">
      <!-- ── Hero ─────────────────────────────────────────────────────── -->
      <section class="relative isolate flex min-h-[86svh] flex-col items-center justify-center px-5 py-20 text-center sm:py-28">
        <div class="love-glow love-glow--a" aria-hidden="true"></div>
        <div class="love-glow love-glow--b" aria-hidden="true"></div>

        <div class="love-hearts" aria-hidden="true">
          {hearts.map((h) => (
            <span
              class="love-heart"
              style={`--x:${h.x}%;--s:${h.s}px;--d:${h.d}s;--t:${h.t}s`}
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="100%" height="100%">
                <path d="M12 21s-7.5-4.7-9.5-9.2C1 8.2 3.2 4.5 6.9 4.5c2 0 3.6 1.1 5.1 2.9 1.5-1.8 3.1-2.9 5.1-2.9 3.7 0 5.9 3.7 4.4 7.3C19.5 16.3 12 21 12 21z" />
              </svg>
            </span>
          ))}
        </div>

        <p class="reveal eyebrow m-0" data-reveal>
          <span data-lang="th">{hero.eyebrow.th}</span>
          <span data-lang="en">{hero.eyebrow.en}</span>
        </p>

        <h1 class="love-title mt-5 text-[clamp(3.2rem,15vw,8rem)] font-semibold leading-[0.95] tracking-[-0.05em] text-fg">
          <span data-lang="th">{hero.title.th}</span>
          <span data-lang="en">{hero.title.en}</span>
        </h1>

        <p class="mt-6 max-w-[520px] text-[16px] leading-relaxed text-fg-muted sm:text-[18px]">
          <span data-lang="th">{hero.subtitle.th}</span>
          <span data-lang="en">{hero.subtitle.en}</span>
        </p>

        <p class="mt-12 text-[11px] font-semibold uppercase tracking-[0.22em] text-fg-dim">
          <span data-lang="th">{hero.hint.th}</span>
          <span data-lang="en">{hero.hint.en}</span>
          <span class="love-scroll-dot" aria-hidden="true"></span>
        </p>
      </section>

      <!-- ── Reasons ──────────────────────────────────────────────────── -->
      <section class="container-apple py-20 sm:py-28">
        <div class="max-w-[640px]" data-reveal>
          <p class="eyebrow">
            <span data-lang="th">เหตุผลที่รักเธอ</span>
            <span data-lang="en">Reasons I love you</span>
          </p>
          <h2 class="headline mt-3 text-[34px] sm:text-[48px]">
            <span data-lang="th">มีมากกว่าที่จะเขียนหมด</span>
            <span data-lang="en">More than I could ever list</span>
          </h2>
        </div>

        <ol class="mt-10 grid list-none grid-cols-1 gap-4 p-0 sm:mt-14 sm:grid-cols-2 lg:grid-cols-3">
          {reasons.map((reason, i) => (
            <li class="love-card" data-reveal style={`transition-delay:${i * 60}ms`}>
              <span class="love-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <p class="mt-6 text-[15px] leading-relaxed text-fg-body sm:text-[16px]">
                <span data-lang="th">{reason.th}</span>
                <span data-lang="en">{reason.en}</span>
              </p>
            </li>
          ))}
        </ol>
      </section>

      <!-- ── Moments ──────────────────────────────────────────────────── -->
      <section class="container-apple pb-20 sm:pb-28">
        <div class="love-panel" data-reveal>
          <p class="eyebrow">
            <span data-lang="th">ช่วงเวลาของเรา</span>
            <span data-lang="en">Our moments</span>
          </p>
          <h2 class="headline mt-3 text-[32px] sm:text-[44px]">
            <span data-lang="th">เรื่องเล่าเล็ก ๆ ที่เราสร้างกัน</span>
            <span data-lang="en">The little story we made together</span>
          </h2>

          <ol class="love-timeline mt-10 list-none p-0">
            {moments.map((moment) => (
              <li class="love-moment">
                <span class="love-moment__dot" aria-hidden="true"></span>
                <div>
                  <p class="love-moment__date">
                    <span data-lang="th">{moment.date.th}</span>
                    <span data-lang="en">{moment.date.en}</span>
                  </p>
                  <h3 class="mt-1.5 text-[19px] font-semibold leading-snug tracking-[-0.01em] text-fg sm:text-[22px]">
                    <span data-lang="th">{moment.title.th}</span>
                    <span data-lang="en">{moment.title.en}</span>
                  </h3>
                  <p class="mt-1.5 max-w-[560px] text-[14px] leading-relaxed text-fg-muted sm:text-[15px]">
                    <span data-lang="th">{moment.desc.th}</span>
                    <span data-lang="en">{moment.desc.en}</span>
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ── Letter ───────────────────────────────────────────────────── -->
      <section class="container-apple pb-24 sm:pb-32">
        <div class="mx-auto max-w-[720px]" data-reveal>
          <details class="love-letter group">
            <summary class="love-letter__btn">
              <span class="love-letter__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="22" height="22">
                  <rect x="3" y="5" width="18" height="14" rx="2.5" />
                  <path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span>
                <span class="block text-[15px] font-semibold text-fg">
                  <span data-lang="th">เปิดจดหมาย</span>
                  <span data-lang="en">Open the letter</span>
                </span>
                <span class="mt-0.5 block text-[12px] text-fg-muted">
                  <span data-lang="th">กดตรงนี้ได้เลย</span>
                  <span data-lang="en">Tap here</span>
                </span>
              </span>
              <span class="love-letter__chev" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                  <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </summary>

            <div class="love-letter__body">
              <p class="whitespace-pre-line text-[15px] leading-[1.9] text-fg-body sm:text-[16px]">
                <span data-lang="th">{letter.th}</span>
                <span data-lang="en">{letter.en}</span>
              </p>
            </div>
          </details>
        </div>
      </section>

      <!-- ── Closing ──────────────────────────────────────────────────── -->
      <section class="relative isolate overflow-hidden px-5 pb-24 text-center sm:pb-32">
        <div class="love-glow love-glow--c" aria-hidden="true"></div>
        <blockquote class="mx-auto max-w-[760px]" data-reveal>
          <p class="text-[clamp(1.6rem,6vw,3.2rem)] font-semibold leading-[1.15] tracking-[-0.03em] text-fg">
            <span data-lang="th">{closing.th}</span>
            <span data-lang="en">{closing.en}</span>
          </p>
          <footer class="mt-7 text-[13px] font-medium tracking-[0.16em] text-fg-dim uppercase">
            <span data-lang="th">ด้วยรักทั้งหมด · กีต้า</span>
            <span data-lang="en">With all my love · Guitar</span>
          </footer>
        </blockquote>

        <div class="mt-16 flex justify-center">
          <BackHome />
        </div>
      </section>
    </main>
  </div>
</Base>

