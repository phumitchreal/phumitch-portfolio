---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import BirthdayCountdown, { nextBirthday } from "../components/BirthdayCountdown.tsx";
import BackHome from "../components/BackHome.astro";
import Footer from "../components/Footer.astro";

// The live target, computed at build time with the same helper the island uses.
const target = nextBirthday();
const WEEKDAYS_EN = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const MONTHS_EN = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const WEEKDAYS_TH = ["วันอาทิตย์", "วันจันทร์", "วันอังคาร", "วันพุธ", "วันพฤหัสบดี", "วันศุกร์", "วันเสาร์"];
const MONTHS_TH = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];

const dateEn = `${WEEKDAYS_EN[target.getDay()]}, ${target.getDate()} ${MONTHS_EN[target.getMonth()]} ${target.getFullYear()}`;
const dateTh = `${WEEKDAYS_TH[target.getDay()]}ที่ ${target.getDate()} ${MONTHS_TH[target.getMonth()]} ${target.getFullYear() + 543}`;
---

<Base
  title="Birthday · Guitar | phumitch.space"
  description={`Countdown to Guitar's next birthday · 11 August · ${dateEn}`}
>
  <div class="relative flex min-h-screen flex-col overflow-x-clip bg-bg text-fg-body">
    <SiteNav />

    <main id="main" class="relative isolate flex flex-1 flex-col items-center px-4 py-12 text-center md:px-6 md:py-16">
      <div class="reveal mb-14 md:mb-18">
        <BackHome />
      </div>

      <h1 class="reveal reveal-1 mt-4 text-3xl font-semibold tracking-normal text-fg md:text-5xl">
        <span data-lang="en">11 August 2008 <span class="font-normal text-fg/40">· Guitar</span></span>
        <span data-lang="th">11 สิงหาคม 2551 <span class="font-normal text-fg/40">· กีต้า</span></span>
      </h1>
      <p class="reveal reveal-2 mt-3 max-w-[620px] text-sm leading-relaxed text-fg/55 md:text-base">
        <span data-lang="en">Counting down to the next birthday — {dateEn} (live, second by second).</span>
        <span data-lang="th">นับถอยหลังสู่วันเกิดครั้งถัดไป — {dateTh} (เรียลไทม์ทุกวินาที)</span>
      </p>

      <div
        class="reveal reveal-3 mt-8 max-w-full rounded-2xl border border-line bg-fg/[0.02] px-4 py-8 shadow-[var(--shadow-panel)] backdrop-blur-sm sm:mt-10 sm:px-6 sm:py-11 md:mt-12 md:px-8 md:py-14"
      >
        <BirthdayCountdown
          client:load
          fontSize="clamp(1.6rem, 8vw, 3.75rem)"
          gap="clamp(10px, 4.5vw, 30px)"
          showSeparators
          fontFamily="var(--ff-body)"
          tint="var(--text)"
          labelColor="var(--text-muted)"
          labels={{
            days: { en: "Days", th: "วัน" },
            hours: { en: "Hours", th: "ชั่วโมง" },
            minutes: { en: "Minutes", th: "นาที" },
            seconds: { en: "Seconds", th: "วินาที" },
          }}
        />
      </div>

      <p class="reveal reveal-4 mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-fg/25 md:mt-5">
        <span data-lang="en">Until {dateEn}</span>
        <span data-lang="th">จนถึง{dateTh}</span>
      </p>
    </main>

    <Footer active="birthday" />
  </div>
</Base>
