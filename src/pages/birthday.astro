---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import BirthdayCountdown from "../components/BirthdayCountdown.tsx";
---

<Base title="Birthday · Guitar | phumitch.space" description="Countdown to Guitar's next birthday · 11 August · ภูมิทัศน์ สมศรี">
  <div class="relative flex flex-col min-h-screen overflow-x-clip bg-[#0a0a0a] text-white selection:bg-[#722f38] selection:text-white">
    <SiteNav />

    <main class="relative isolate flex flex-1 flex-col items-center px-4 py-12 md:px-6 md:py-16 text-center">
      <a
        href="/"
        class="group mb-14 inline-flex h-9 items-center gap-2 rounded-lg border border-white/10 bg-white/[0.02] px-4 text-xs font-medium text-white/50 transition-all duration-300 hover:border-white/20 hover:bg-white/[0.06] hover:text-white md:mb-18 md:px-5"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-3.5 w-3.5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
        <span data-lang="en">Back to Home</span>
        <span data-lang="th">กลับหน้าแรก</span>
      </a>

      <span aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 hidden select-none items-center justify-center md:flex">
        <span data-lang="en" class="hero-ghost hero-ghost-sm whitespace-nowrap">HAPPY BIRTHDAY</span>
        <span data-lang="th" class="hero-ghost hero-ghost-sm whitespace-nowrap">สุขสันต์วันเกิด</span>
      </span>

      <h1 class="mt-4 text-3xl font-semibold tracking-normal text-white md:text-5xl">
        <span data-lang="en">11 August 2008 <span class="text-white/40 font-normal">· Guitar</span></span>
        <span data-lang="th">11 สิงหาคม 2551 <span class="text-white/40 font-normal">· กีต้า</span></span>
      </h1>
      <p class="mt-3 max-w-[620px] text-sm leading-relaxed text-white/55 md:text-base">
        <span data-lang="en">Counting down to the next birthday — Monday, 11 August 2027 (live, second by second).</span>
        <span data-lang="th">นับถอยหลังสู่วันเกิดครั้งถัดไป — วันจันทร์ที่ 11 สิงหาคม 2560 (เรียลไทม์ทุกวินาที)</span>
      </p>

      <div class="mt-8 max-w-full rounded-2xl border border-white/[0.08] bg-white/[0.02] px-4 py-8 backdrop-blur-sm sm:mt-10 sm:px-6 sm:py-11 md:mt-12 md:px-8 md:py-14 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.6)]">
        <BirthdayCountdown
          client:load
          fontSize="clamp(1.6rem, 8vw, 3.75rem)"
          gap="clamp(10px, 4.5vw, 30px)"
          showSeparators
          labels={{
            days: { en: "Days", th: "วัน" },
            hours: { en: "Hours", th: "ชั่วโมง" },
            minutes: { en: "Minutes", th: "นาที" },
            seconds: { en: "Seconds", th: "วินาที" },
          }}
        />
      </div>

      <p class="mt-4 text-[11px] uppercase tracking-[0.14em] text-white/25 md:mt-5" style="font-family: var(--font-mono)">
        <span data-lang="en">Until Monday, 11 August 2027</span>
        <span data-lang="th">จนถึงวันจันทร์ที่ 11 สิงหาคม 2560</span>
      </p>
    </main>

    <footer class="mx-auto flex w-full max-w-[800px] flex-wrap items-center justify-center gap-6 border-t border-white/[0.06] px-6 py-8 text-xs text-white/30">
      <a href="/about" class="transition-colors hover:text-white"><span data-lang="en">About</span><span data-lang="th">เกี่ยวกับ</span></a>
      <a href="/birthday" class="transition-colors hover:text-white text-white/80"><span data-lang="en">Birthday</span><span data-lang="th">วันเกิด</span></a>
      <a href="/privacy" class="transition-colors hover:text-white"><span data-lang="en">Privacy</span><span data-lang="th">ความเป็นส่วนตัว</span></a>
      <a href="/terms" class="transition-colors hover:text-white"><span data-lang="en">Terms</span><span data-lang="th">ข้อกำหนด</span></a>
      <a href="/acceptable-use" class="transition-colors hover:text-white"><span data-lang="en">Acceptable Use</span><span data-lang="th">การใช้งานที่เหมาะสม</span></a>
    </footer>
  </div>
</Base>