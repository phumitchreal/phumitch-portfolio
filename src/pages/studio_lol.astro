---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";

const invite = "https://discord.gg/ADRNFfavHa";
const icon = "https://cdn.discordapp.com/icons/1551900946211147827/7ba5c4daaa868a3eac98b2d2ccae029f.png?size=256";
const title = "𝕾tudio.lol — Join the Discord Server";
const description = "Check out the 𝕾tudio.lol community on Discord — hang out with 3 other members and enjoy free voice and text chat. Est. Sep 2026";
---

<Base title={title} description={description}>
  <div class="relative flex min-h-[100dvh] flex-col bg-[#0a0a0a] text-white selection:bg-white/25 selection:text-white">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <video
        id="studio-bg"
        class="h-full w-full object-cover"
        src="/studio-lol-bg.mp4"
        poster="/studio-lol-bg.jpg"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        tabindex="-1"
      ></video>
      <div class="absolute inset-0 bg-[#0a0a0a]/72"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/85 via-[#0a0a0a]/30 to-[#0a0a0a]/90"></div>
    </div>

    <div class="relative z-10">
      <SiteNav />
    </div>

    <main class="relative z-10 flex flex-1 flex-col items-center justify-center px-6 py-20">
      <div class="fade-up flex w-full max-w-[560px] flex-col items-center text-center">
        <img
          id="solo-icon"
          src={icon}
          alt="𝕾tudio.lol icon"
          width="112"
          height="112"
          class="mb-9 block h-24 w-24 rounded-2xl border border-white/[0.08] bg-white/[0.03] object-cover md:h-28 md:w-28"
          loading="eager"
          decoding="async"
        />

        <p class="text-[10px] font-bold uppercase tracking-[0.28em] text-white/30" style="font-family: var(--font-mono)">
          <span data-lang="en">Discord Community</span>
          <span data-lang="th">คอมมูนิตี้ Discord</span>
        </p>

        <h1 id="solo-name" class="hero-title mt-5 text-white">𝕾tudio.lol</h1>

        <p class="mt-5 max-w-[440px] text-sm leading-relaxed text-white/60 md:text-[15px]">
          <span data-lang="en"
            >The server for the studio — a small, cozy place to hang out, share work-in-progress, and vibe together.</span
          ><span data-lang="th"
            >เซิร์ฟเวอร์ของสตูดิโอ — อยู่กันแบบสนิทๆ มาแชร์ผลงาน นั่งเล่น และสังสรรค์กันได้</span
          >
        </p>

        <div class="mt-10 w-full max-w-[340px]">
          <a
            href={invite}
            target="_blank"
            rel="noopener"
            class="group flex h-[52px] w-full items-center justify-center gap-2.5 rounded-full bg-[#5865F2] text-[15px] font-semibold text-white transition-all duration-300 hover:bg-[#4752c4] hover:shadow-[0_12px_40px_-12px_rgba(88,101,242,0.6)] active:scale-[0.99]"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 text-white/90 transition-transform duration-300 group-hover:-translate-y-0.5" fill="currentColor"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03ZM8.02 15.331c-1.182 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418Zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418Z"/></svg>
            <span data-lang="en">Join Server</span>
            <span data-lang="th">เข้าร่วมเซิร์ฟเวอร์</span>
          </a>
        </div>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-2">
          <span class="inline-flex h-8 items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.03] px-3.5 text-[12px] font-medium text-white/70">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#23a559]/60"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-[#23a559]"></span>
            </span>
            <span data-lang="en">Online</span><span data-lang="th">ออนไลน์</span>&nbsp;<span id="solo-online" data-lang-en-label="Online">—</span>
          </span>
          <span class="inline-flex h-8 items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.03] px-3.5 text-[12px] font-medium text-white/70">
            <span class="inline-flex h-2 w-2 rounded-full bg-white/25"></span>
            <span data-lang="en">Members</span><span data-lang="th">สมาชิก</span>&nbsp;<span id="solo-members">—</span>
          </span>
          <span class="inline-flex h-8 items-center rounded-full border border-white/[0.08] bg-white/[0.03] px-3.5 text-[12px] font-medium text-white/70">
            <span data-lang="en">Est. Sep 2026</span><span data-lang="th">ก่อตั้ง ก.ย. 2026</span>
          </span>
        </div>
      </div>
    </main>

    <script>
      (async () => {
        const onlineEl = document.getElementById("solo-online");
        const membersEl = document.getElementById("solo-members");
        const iconEl = document.getElementById("solo-icon") as HTMLImageElement | null;
        const nameEl = document.getElementById("solo-name");
        try {
          const res = await fetch("/api/studio-lol-counts");
          if (!res.ok) throw new Error(String(res.status));
          const data = await res.json();
          if (onlineEl && data.online != null) onlineEl.textContent = data.online;
          if (membersEl && data.members != null) membersEl.textContent = data.members;
          if (data.profile) {
            if (iconEl && data.profile.icon) iconEl.src = data.profile.icon;
            if (nameEl && data.profile.name) nameEl.textContent = data.profile.name;
          }
        } catch (_) {
          /* keep the static fallback text */
        }
      })();
    </script>

    <div class="relative z-10 mx-auto flex w-full max-w-[800px] items-center justify-center gap-6 border-t border-white/[0.06] px-6 py-8 text-xs text-white/30">
      <a href="/" class="transition-colors hover:text-white"><span data-lang="en">Home</span><span data-lang="th">หน้าแรก</span></a>
      <a href="/portfolio" class="transition-colors hover:text-white"><span data-lang="en">Portfolio</span><span data-lang="th">ผลงาน</span></a>
      <a href="/about" class="transition-colors hover:text-white"><span data-lang="en">About</span><span data-lang="th">เกี่ยวกับ</span></a>
    </div>
  </div>
</Base>