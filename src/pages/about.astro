---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import AboutPage from "../components/AboutPage.tsx";
import BackHome from "../components/BackHome.astro";
import Footer from "../components/Footer.astro";
import { getProfile } from "../lib/portfolioData.ts";

const profile = await getProfile();
---

<Base
  title="About · Guitar | phumitch.space"
  description="About Guitar · Expert in prompting AI to build production websites"
>
  <div class="relative flex min-h-screen flex-col text-fg-body">
    <SiteNav />

    <main id="main" class="relative z-10 mx-auto w-full max-w-[1080px] flex-1 px-4 pb-20 pt-20 sm:px-6 sm:pt-28">
      <AboutPage profile={profile} client:load />

      <div class="mt-16 border-t border-line pt-8">
        <BackHome />
      </div>
    </main>

    <Footer active="about" />
  </div>
</Base>
