---
import aboutPhoto from "../assets/about-photo.jpg";
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import AboutPage from "../components/AboutPage.tsx";
import BackHome from "../components/BackHome.astro";
import Footer from "../components/Footer.astro";
import { getProfile } from "../lib/portfolioData.ts";

const profile = await getProfile();
---

<Base
  title="About · Guitar | phumitch.space"
  description="About Guitar · Expert in prompting AI to build production websites"
>
  <div class="relative flex min-h-screen flex-col text-fg-body">
    <SiteNav />

    <main id="main" class="relative z-10 mx-auto w-full max-w-[1080px] flex-1 px-4 pb-20 pt-20 sm:px-6 sm:pt-28">
      <header class="reveal flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-7">
        <img
          src={profile.about.photo_url || aboutPhoto.src}
          alt={`${profile.personal.fullName[1]} (${profile.personal.nickname[1]}) — ${profile.personal.fullName[0]}`}
          class="h-24 w-24 shrink-0 rounded-full object-cover shadow-[var(--shadow-panel)] ring-1 ring-black/[0.06] sm:h-28 sm:w-28"
          style="object-position: center 30%"
          loading="eager"
        />
        <div class="min-w-0">
          <p class="eyebrow">
            <span data-lang="en">About</span><span data-lang="th">เกี่ยวกับ</span>
          </p>
          <h1 class="page-title mt-2">
            <span data-lang="en">{profile.personal.fullName[0]}</span><span data-lang="th">{profile.personal.fullName[1]}</span>
          </h1>
          <p class="mt-3 flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center rounded-full bg-accent-soft px-3 py-1 text-[12px] font-medium text-accent">
              <span data-lang="en">Nickname: {profile.personal.nickname[0]}</span><span data-lang="th">ชื่อเล่น: {profile.personal.nickname[1]}</span>
            </span>
            <span class="inline-flex items-center rounded-full bg-mist px-3 py-1 text-[12px] font-medium text-fg-muted">
              <span data-lang="en">Status: {profile.personal.status?.[0] || 'Single'}</span>
              <span data-lang="th">สถานะ: {profile.personal.status?.[1] || 'โสด'}</span>
            </span>
          </p>
        </div>
      </header>

      <p class="reveal reveal-1 lede mt-6">
        <span data-lang="en">{profile.about.desc_en}</span><span data-lang="th">{profile.about.desc_th}</span>
      </p>

      <AboutPage profile={profile} client:load />

      <div class="mt-16 border-t border-line pt-8">
        <BackHome />
      </div>
    </main>

    <Footer active="about" />
  </div>
</Base>
