---
import { Image } from "astro:assets";
import aboutPhoto from "../assets/about-photo.jpg";
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import AboutPage from "../components/AboutPage.tsx";
import BackHome from "../components/BackHome.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="About · Guitar | phumitch.space"
  description="About Guitar · Expert in prompting AI to build production websites"
>
  <div class="relative flex min-h-screen flex-col text-fg-body">
    <SiteNav />

    <main id="main" class="relative z-10 mx-auto w-full max-w-[1080px] flex-1 px-4 pb-20 pt-20 sm:px-6 sm:pt-28">
      <header class="reveal flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-7">
        <Image
          src={aboutPhoto}
          alt="ภูมิทัศน์ สมศรี (กีต้า) — Phumitch Somsri"
          widths={[128, 192, 256]}
          sizes="112px"
          class="h-24 w-24 shrink-0 rounded-full object-cover shadow-[var(--shadow-panel)] ring-1 ring-black/[0.06] sm:h-28 sm:w-28"
          style="object-position: center 30%"
          loading="eager"
        />
        <div class="min-w-0">
          <p class="eyebrow">
            <span data-lang="en">About</span><span data-lang="th">เกี่ยวกับ</span>
          </p>
          <h1 class="page-title mt-2">
            <span data-lang="en">Phumitch Somsri</span><span data-lang="th">ภูมิทัศน์ สมศรี</span>
          </h1>
          <p class="mt-3 flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center rounded-full bg-accent-soft px-3 py-1 text-[12px] font-medium text-accent">
              <span data-lang="en">Nickname: Guitar</span><span data-lang="th">ชื่อเล่น: กีต้า</span>
            </span>
            <span class="text-[13px] text-fg-muted">
              <span data-lang="en">Vibe Coding · Full-stack Developer</span>
              <span data-lang="th">Vibe Coding · นักพัฒนา Full-stack</span>
            </span>
          </p>
        </div>
      </header>

      <p class="reveal reveal-1 lede mt-6">
        <span data-lang="en"
          >Vibe Coding · Prompting AI to architect and build production-grade web applications. Focused on Full-stack development, modern UI &amp; AI tooling.</span
        ><span data-lang="th"
          >Vibe Coding · สั่ง AI เขียนโค้ดสถาปัตยกรรมเว็บระดับ Production ไม่ใช่แค่เดโม่ โฟกัสการพัฒนา Full-stack, Modern UI และ AI tooling</span
        >
      </p>

      <AboutPage client:load />

      <div class="mt-16 border-t border-line pt-8">
        <BackHome />
      </div>
    </main>

    <Footer active="about" />
  </div>
</Base>
