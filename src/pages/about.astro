---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import AboutPage from "../components/AboutPage.tsx";
import PageHero from "../components/PageHero.astro";
import BackHome from "../components/BackHome.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="About · Guitar | phumitch.space"
  description="About Guitar · Expert in prompting AI to build production websites"
>
  <div class="relative flex min-h-screen flex-col bg-bg text-fg-body">
    <div aria-hidden="true" class="ambient-glow"></div>

    <SiteNav />

    <main id="main" class="relative z-10 mx-auto w-full max-w-page flex-1 px-6 py-10 md:py-16">
      <PageHero
        eyebrow={{ en: "About", th: "เกี่ยวกับ" }}
        lede={{
          en: "Vibe Coding · Prompting AI to architect and build production-grade web applications. Focused on Full-stack development, modern UI & AI tooling.",
          th: "Vibe Coding · สั่ง AI เขียนโค้ดสถาปัตยกรรมเว็บระดับ Production ไม่ใช่แค่เดโม่ โฟกัสการพัฒนา Full-stack, Modern UI และ AI tooling",
        }}
      >
        <span data-lang="en"
          >Phumitch Somsri <span class="font-normal text-fg/40">· Guitar</span></span
        ><span data-lang="th"
          >ภูมิทัศน์ สมศรี <span class="font-normal text-fg/40">· กีต้า</span></span
        >
      </PageHero>

      <AboutPage client:load />

      <div class="mt-14 border-t border-line pt-8">
        <BackHome />
      </div>
    </main>

    <Footer active="about" />
  </div>
</Base>
