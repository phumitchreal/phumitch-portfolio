---
import Base from "../layouts/Base.astro";
import IsaevaNav from "../components/IsaevaNav.astro";
---

<Base title="Privacy Policy · phumitch.space" description="Privacy Policy for Phumitch Somsri's portfolio and services">
  <div class="relative min-h-screen bg-[#0a0a0a] text-white selection:bg-[#722f38] selection:text-white">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-96 bg-[radial-gradient(ellipse_60%_50%_at_50%_0%,rgba(114,47,56,0.12),transparent)]"></div>

    <IsaevaNav />

    <div class="relative mx-auto max-w-[800px] px-6 py-10 md:py-16">
      <div class="fade-up space-y-3">
        <p class="text-xs font-medium tracking-wider text-white/40">
          <span data-lang="en">LEGAL</span>
          <span data-lang="th">ข้อกฎหมาย</span>
        </p>
        <h1 class="text-3xl font-semibold tracking-normal text-white md:text-5xl">
          <span data-lang="en">Privacy Policy</span>
          <span data-lang="th">นโยบายความเป็นส่วนตัว</span>
        </h1>
        <p class="text-xs text-white/40" style="font-family: var(--font-mono)">
          <span data-lang="en">Last updated: September 18, 2026</span>
          <span data-lang="th">อัปเดตล่าสุด: 18 กันยายน 2026</span>
        </p>
      </div>

      <div class="mt-10 space-y-8 text-sm leading-relaxed text-white/70">
        <section class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-5 space-y-2">
          <h2 class="text-base font-semibold text-white">
            <span data-lang="en">1. Overview</span>
            <span data-lang="th">1. ภาพรวม</span>
          </h2>
          <p>
            <span data-lang="en">This Privacy Policy explains how phumitch.space handles information. We value your privacy and keep data collection minimal.</span>
            <span data-lang="th">นโยบายความเป็นส่วนตัวนี้อธิบายการจัดการข้อมูลของ phumitch.space เราให้ความสำคัญกับความเป็นส่วนตัวของคุณและเก็บข้อมูลน้อยที่สุดเท่าที่จำเป็น</span>
          </p>
        </section>

        <section class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-5 space-y-2">
          <h2 class="text-base font-semibold text-white">
            <span data-lang="en">2. Data Storage & Local Preferences</span>
            <span data-lang="th">2. การเก็บข้อมูลและการตั้งค่าในเครื่อง</span>
          </h2>
          <p>
            <span data-lang="en">We do not use tracking cookies or sell user data. LocalStorage is strictly used to remember your theme preference (dark/light) and language selection (English/Thai) in your browser.</span>
            <span data-lang="th">เราไม่ใช้ คุกกี้ติดตามพฤติกรรม (Tracking Cookies) และไม่มีการขายข้อมูลผู้ใช้ ข้อมูลใน LocalStorage ใช้เฉพาะเพื่อบันทึกธีม (Dark/Light) และภาษา (ไทย/อังกฤษ) บนเบราว์เซอร์ของคุณเท่านั้น</span>
          </p>
        </section>

        <section class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-5 space-y-2">
          <h2 class="text-base font-semibold text-white">
            <span data-lang="en">3. Hosting Infrastructure & Server Logs</span>
            <span data-lang="th">3. โครงสร้างพื้นฐานและบันทึกเซิร์ฟเวอร์</span>
          </h2>
          <p>
            <span data-lang="en">Our site is hosted on Vercel Network. Standard access logs (such as IP address and HTTP user-agent) may be recorded by Vercel for security, DDoS protection, and diagnostic performance purposes.</span>
            <span data-lang="th">เว็บไซต์นี้โฮสต์บน Vercel Network บันทึกการเข้าถึงมาตรฐาน (เช่น IP Address และ User-Agent) อาจถูกจัดเก็บโดยเครือข่าย Vercel เพื่อความปลอดภัย การป้องกัน DDoS และการวิเคราะห์ประสิทธิภาพ</span>
          </p>
        </section>

        <section class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-5 space-y-2">
          <h2 class="text-base font-semibold text-white">
            <span data-lang="en">4. External Links & Services</span>
            <span data-lang="th">4. ลิงก์ไปยังบริการภายนอก</span>
          </h2>
          <p>
            <span data-lang="en">Our website contains links to third-party services like GitHub, Instagram, Discord, and BuyMeACoffee. Visiting external services is governed by their respective privacy terms.</span>
            <span data-lang="th">เว็บไซต์นี้มีลิงก์ไปยังบริการภายนอก เช่น GitHub, Instagram, Discord และ BuyMeACoffee การเข้าชมบริการเหล่านั้นจะเป็นไปตามนโยบายความเป็นส่วนตัวของแพลตฟอร์มนั้นๆ</span>
          </p>
        </section>

        <section class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-5 space-y-2">
          <h2 class="text-base font-semibold text-white">
            <span data-lang="en">5. Contact Information</span>
            <span data-lang="th">5. ข้อมูลการติดต่อ</span>
          </h2>
          <p>
            <span data-lang="en">For privacy inquiries or technical questions, contact via Discord <code class="text-white/90">@phumitch.exe</code> or GitHub <code class="text-white/90">@phumitchreal</code>.</span>
            <span data-lang="th">หากมีข้อสงสัยเกี่ยวกับความเป็นส่วนตัว ติดต่อได้ทาง Discord <code class="text-white/90">@phumitch.exe</code> หรือ GitHub <code class="text-white/90">@phumitchreal</code></span>
          </p>
        </section>
      </div>

      <div class="mt-14 flex items-center justify-between border-t border-white/[0.06] pt-8">
        <a href="/" class="inline-flex h-9 items-center gap-2 rounded-lg border border-white/10 bg-white/[0.02] px-4 text-xs font-medium text-white/50 transition-all duration-300 hover:border-white/20 hover:bg-white/[0.06] hover:text-white">
          <span data-lang="en">← Back to Home</span>
          <span data-lang="th">← กลับหน้าแรก</span>
        </a>
      </div>
    </div>

    <div class="mx-auto flex w-full max-w-[800px] flex-wrap items-center justify-center gap-6 border-t border-white/[0.06] px-6 py-8 text-xs text-white/30">
      <a href="/about" class="transition-colors hover:text-white"><span data-lang="en">About</span><span data-lang="th">เกี่ยวกับ</span></a>
      <a href="/privacy" class="transition-colors hover:text-white text-white/80"><span data-lang="en">Privacy</span><span data-lang="th">ความเป็นส่วนตัว</span></a>
      <a href="/terms" class="transition-colors hover:text-white"><span data-lang="en">Terms</span><span data-lang="th">ข้อกำหนด</span></a>
      <a href="/acceptable-use" class="transition-colors hover:text-white"><span data-lang="en">Acceptable Use</span><span data-lang="th">การใช้งานที่เหมาะสม</span></a>
    </div>
  </div>
</Base>