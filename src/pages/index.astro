---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import HeroMotion from "../components/HeroMotion.tsx";
import HomeWorkShowcase from "../components/HomeWorkShowcase.tsx";
import HomeAboutShowcase from "../components/HomeAboutShowcase.tsx";
import GirlfriendCard from "../components/GirlfriendCard.astro";
import Footer from "../components/Footer.astro";
import { getProjects, getProfile } from "../lib/portfolioData.ts";

const initialWorks = await getProjects();
const initialProfile = await getProfile();
---

<Base
  title="Phumitch Somsri · Guitar | Vibe Coding Full-stack · Zexta Studio"
  description="Phumitch Somsri (Guitar) — expert in prompting AI to build production websites, Vibe Coding · Full-stack · Zexta Studio. See selected work, artwork design, and bot projects."
  keywords="Phumitch Somsri, Guitar, Zexta Studio, Discord Bot, Full-stack, Astro, React, Web Development, Thai developer, phumitch.space"
  ogImage="/og/home.jpg"
>
  <div class="relative flex min-h-[100dvh] flex-col text-fg-body">
    <SiteNav />
    <main id="main" class="relative z-10 flex flex-1 flex-col">
      <HeroMotion client:load initialProfile={initialProfile} />
      <HomeWorkShowcase client:load initialWorks={initialWorks} />
      <HomeAboutShowcase client:load initialProfile={initialProfile} />
      <GirlfriendCard girlfriend={initialProfile.girlfriend} />
    </main>
    <Footer />
  </div>
</Base>



