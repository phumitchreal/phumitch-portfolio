---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import HeroMotion from "../components/HeroMotion.tsx";
import HomeWork from "../components/HomeWork.astro";
import HomeAbout from "../components/HomeAbout.astro";
import SongCard from "../components/SongCard.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <div class="relative flex min-h-[100dvh] flex-col text-fg-body">
    <SiteNav />
    <main id="main" class="relative z-10 flex flex-1 flex-col">
      <HeroMotion client:load />
      <HomeWork />
      <HomeAbout />
      <SongCard />
    </main>
    <Footer />
  </div>
</Base>
