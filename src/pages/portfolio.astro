---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import PageHero from "../components/PageHero.astro";
import WorkGrid from "../components/WorkGrid.astro";
import BackHome from "../components/BackHome.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Work · Guitar | phumitch.space"
  description="Selected work of Guitar · Zexta Studio and other projects"
>
  <div class="relative flex min-h-screen flex-col bg-bg text-fg-body">
    <SiteNav />

    <main id="main" class="relative mx-auto w-full max-w-page flex-1 px-6 py-8 md:py-12">
      <PageHero
        eyebrow={{ en: "Portfolio", th: "ผลงาน" }}
        lede={{
          en: "Selected projects · every piece designed for real use, scalable and maintainable",
          th: "ผลงานที่เลือก · ทุกชิ้นออกแบบเพื่อใช้งานจริง มั่นคงและดูแลง่าย",
        }}
      >
        <span data-lang="en">Selected Work</span><span data-lang="th">ผลงานที่เลือก</span>
      </PageHero>

      <div class="mt-10">
        <WorkGrid />
      </div>

      <div class="mt-8">
        <BackHome />
      </div>
    </main>

    <Footer active="portfolio" />
  </div>
</Base>
