---
---

<section id="hero" class="relative overflow-hidden">
  <!-- composition: grid + blobs -->
  <div
    aria-hidden
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px); background-size: 32px 32px;"
  ></div>
  <div
    aria-hidden
    class="pointer-events-none absolute -top-24 -right-24 h-[420px] w-[420px] rounded-full opacity-20 blur-3xl"
    style="background: radial-gradient(circle at 30% 30%, var(--accent), transparent 65%);"
  ></div>
  <div
    aria-hidden
    class="pointer-events-none absolute -bottom-32 -left-32 h-[520px] w-[520px] rounded-full opacity-10 blur-3xl"
    style="background: radial-gradient(circle at 50% 50%, var(--accent), transparent 70%);"
  ></div>

  <!-- ghost watermark with parallax -->
  <div
    id="hero-ghost"
    aria-hidden
    class="hero-ghost pointer-events-none absolute inset-0 flex items-center justify-center select-none will-change-transform"
    style="transition: transform 0.18s ease-out;"
  >
    <span class="translate-x-[-2%] translate-y-[-6%]">GUITAR</span>
  </div>

  <!-- wordmark trace line -->
  <div
    aria-hidden
    class="pointer-events-none absolute left-1/2 top-[22%] h-px w-[68%] -translate-x-1/2 overflow-hidden opacity-30"
    style="background: var(--border-strong); transform-origin: left; animation: scaleIn 1.4s cubic-bezier(.16,1,.3,1) 0.4s forwards; transform: scaleX(0);"
  ></div>

  <div class="relative mx-auto max-w-[1200px] px-6 py-8 md:py-12">
    <!-- banner -->
    <div
      class="overflow-hidden rounded-2xl border fade-up"
      style="border-color: var(--border); background: var(--surface); animation-delay: 0s;"
    >
      <img
        src="/35070.gif"
        alt="banner"
        class="h-44 w-full object-cover sm:h-52"
        loading="eager"
        onerror="this.style.display='none'"
      />
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <div>
        <p
          class="text-xs font-bold tracking-[0.45em] uppercase fade-up"
          style="color: var(--text-dim); animation-delay: 0.06s;"
        >
          สวัสดีครับ — PHUMITCH
        </p>

        <h1
          class="hero-title mt-4 fade-up"
          style="color: var(--text); animation-delay: 0.12s;"
        >
          ผม <span style="color: var(--accent);">กีต้า</span>
        </h1>

        <div
          class="mt-5 border-l-2 pl-4 fade-up"
          style="border-color: var(--border); animation-delay: 0.18s;"
        >
          <p class="text-sm leading-relaxed" style="color: var(--text-muted);">ผู้เชี่ยวชาญด้านการสั่ง AI เขียนเว็บ</p>
          <p class="mt-1 text-sm font-semibold" style="color: var(--accent);">
            Vibe Coding <span style="color: var(--text-dim);" class="mx-1">◆</span>
            <span style="color: var(--text-muted); font-weight: 500;">Full-stack</span>
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3 fade-up" style="animation-delay: 0.24s;">
          <a
            href="#work"
            class="group inline-flex h-10 items-center gap-2 rounded-full px-5 text-sm font-medium transition-colors"
            style="background: var(--accent); color: #fff;"
          >
            ดูผลงาน
            <span class="transition-transform group-hover:translate-x-0.5"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg></span>
          </a>
          <a
            href="https://github.com/phumitchreal"
            target="_blank"
            rel="noopener"
            class="inline-flex h-10 items-center gap-2 rounded-full border px-5 text-sm font-medium transition-colors hover:opacity-90"
            style="background: var(--surface); border-color: var(--border); color: var(--text);"
          >
            <span class="inline-flex items-center gap-2">GitHub @phumitchreal<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-7-7 7 7-7 7"/></svg></span>
          </a>
        </div>

        <div class="mt-10 flex flex-wrap gap-2 text-xs fade-up" style="animation-delay: 0.3s;">
          <span class="rounded-full border px-3 py-1" style="border-color: var(--border); color: var(--text-muted); background: var(--surface);">Cursor</span>
          <span class="rounded-full border px-3 py-1" style="border-color: var(--border); color: var(--text-muted); background: var(--surface);">Claude</span>
          <span class="rounded-full border px-3 py-1" style="border-color: var(--border); color: var(--text-muted); background: var(--surface);">Copilot</span>
          <span class="rounded-full border px-3 py-1" style="border-color: var(--border); color: var(--text-muted); background: var(--surface);">OpenCode</span>
          <span class="rounded-full border px-3 py-1" style="border-color: var(--border); color: var(--text-muted); background: var(--surface);">Antigravity</span>
          <span class="rounded-full border px-3 py-1" style="border-color: var(--border); color: var(--text-muted); background: var(--surface);">TypeScript</span>
          <span class="rounded-full border px-3 py-1" style="border-color: var(--border); color: var(--text-muted); background: var(--surface);">React</span>
          <span class="rounded-full border px-3 py-1" style="border-color: var(--border); color: var(--text-muted); background: var(--surface);">Astro</span>
        </div>
      </div>

      <div
        class="relative overflow-hidden rounded-2xl border fade-up hover:-translate-y-1 transition-transform duration-300"
        style="border-color: var(--border); background: var(--surface); animation-delay: 0.2s;"
      >
        <img
          src="/IMG_3733.jpg"
          alt="ภูมิทัศน์ สมศรี — กีต้า"
          class="aspect-[3/4] w-full object-cover object-top"
          loading="eager"
          onerror="this.src='https://via.placeholder.com/600x800/0a0a0a/722f38?text=GUITAR'"
        />
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-4">
          <p class="text-xs font-medium tracking-wide text-white/90">นครปฐม, ไทย · ปวช. · 11 ส.ค. 2008</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // parallax for ghost - runs without React hydration
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const hero = document.getElementById("hero");
    const ghost = document.getElementById("hero-ghost");
    if (!hero || !ghost) return;
    hero.addEventListener("mousemove", (e) => {
      const rect = hero.getBoundingClientRect();
      const nx = ((e.clientX - rect.left) / rect.width - 0.5) * 40;
      const ny = ((e.clientY - rect.top) / rect.height - 0.5) * 20;
      ghost.style.transform = `translate(${nx}px, ${ny}px)`;
    });
    hero.addEventListener("mouseleave", () => {
      ghost.style.transform = "translate(0, 0)";
    });
  })();
</script>
