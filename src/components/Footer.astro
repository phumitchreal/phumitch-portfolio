---
import ZTIcon from "./ZTIcon.tsx";

interface Props {
  active?: "about" | "birthday" | "privacy" | "terms" | "acceptable-use" | "portfolio" | "studio";
}

const { active } = Astro.props;

const groups = [
  {
    title: { en: "Explore", th: "สำรวจ" },
    links: [
      { href: "/portfolio", key: "portfolio", en: "Work", th: "ผลงาน" },
      { href: "/about", key: "about", en: "About", th: "เกี่ยวกับ" },
      { href: "/birthday", key: "birthday", en: "Birthday", th: "วันเกิด" },
    ],
  },
  {
    title: { en: "Legal", th: "ข้อกฎหมาย" },
    links: [
      { href: "/privacy", key: "privacy", en: "Privacy", th: "ความเป็นส่วนตัว" },
      { href: "/terms", key: "terms", en: "Terms", th: "ข้อกำหนด" },
      { href: "/acceptable-use", key: "acceptable-use", en: "Acceptable Use", th: "การใช้งานที่เหมาะสม" },
    ],
  },
  {
    title: { en: "Elsewhere", th: "ช่องทางอื่น" },
    links: [
      { href: "https://github.com/phumitchreal", key: "github", en: "GitHub", th: "GitHub" },
      { href: "https://instagram.com/null_phumitch", key: "instagram", en: "Instagram", th: "Instagram" },
      { href: "https://discord.com/users/919878532228841532", key: "discord", en: "Discord", th: "Discord" },
    ],
  },
];
---

<footer class="mt-auto border-t border-line bg-mist/70">
  <div class="container-apple py-12 sm:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div class="max-w-xs">
        <a href="/" class="flex items-center gap-2.5" aria-label="Phumitch · Home">
          <ZTIcon size={26} />
          <span class="text-[14px] font-semibold tracking-[-0.01em] text-fg">phumitch.space</span>
        </a>
        <p class="mt-4 text-[13px] leading-relaxed text-fg-muted">
          <span data-lang="en">Vibe Coding · production websites, Discord bots and AI tooling.</span>
          <span data-lang="th">Vibe Coding · เว็บระดับ production, Discord bot และ AI tooling</span>
        </p>
      </div>

      {
        groups.map((g) => (
          <nav aria-label={g.title.en}>
            <p class="text-[12px] font-semibold text-fg">
              <span data-lang="en">{g.title.en}</span>
              <span data-lang="th">{g.title.th}</span>
            </p>
            <ul class="mt-3 space-y-2">
              {g.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.href.startsWith("http") ? "_blank" : undefined}
                    rel={l.href.startsWith("http") ? "noopener" : undefined}
                    class:list={[
                      "text-[13px] transition-colors duration-200 hover:text-fg",
                      active === l.key ? "text-fg" : "text-fg-muted",
                    ]}
                  >
                    <span data-lang="en">{l.en}</span>
                    <span data-lang="th">{l.th}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-line pt-6 text-[12px] text-fg-dim sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© 2026 Phumitch Somsri · Guitar</p>
      <p>
        <span data-lang="en">Built with Astro, React and Framer Motion</span>
        <span data-lang="th">สร้างด้วย Astro, React และ Framer Motion</span>
      </p>
    </div>
  </div>
</footer>
