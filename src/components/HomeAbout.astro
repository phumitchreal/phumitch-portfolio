---
import { Image } from "astro:assets";
import { ArrowUpRightIcon as ArrowUpRight } from "@phosphor-icons/react";
import aboutPhoto from "../assets/about-photo.jpg";
import { dicts } from "../i18n.ts";
import { getProfile } from "../lib/portfolioData.ts";

const profile = await getProfile();
const { en, th } = dicts;

const facts = [
  { en: [en.personal.location[0], profile.personal.location[0]], th: [th.personal.location[0], profile.personal.location[1]], valueEn: profile.personal.location[0], valueTh: profile.personal.location[1] },
  { en: [en.personal.education[0], profile.personal.education[0]], th: [th.personal.education[0], profile.personal.education[1]], valueEn: profile.personal.education[0], valueTh: profile.personal.education[1] },
  { en: [en.personal.nickname[0], profile.personal.nickname[0]], th: [th.personal.nickname[0], profile.personal.nickname[1]], valueEn: profile.personal.nickname[0], valueTh: profile.personal.nickname[1] },
];

const doMini = profile.what_i_do.map((item) => ({
  keyEn: item.en,
  keyTh: item.th,
}));

const socials = profile.socials;
---

<section id="about" class="pb-24 sm:pb-32">
  <div class="container-apple">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-16">
      {/* Portrait + quick links */}
      <div data-reveal class="mx-auto w-full max-w-[360px] lg:mx-0">
        <div class="relative overflow-hidden rounded-[28px] bg-mist ring-1 ring-black/[0.06] shadow-[var(--shadow-panel)]">
          <Image
            src={aboutPhoto}
            alt="ภูมิทัศน์ สมศรี (กีต้า) — Phumitch Somsri"
            widths={[320, 480, 720]}
            sizes="(min-width: 1024px) 360px, 80vw"
            class="aspect-[4/5] h-full w-full object-cover"
            style="object-position: center 30%"
            loading="lazy"
          />
        </div>

        <div class="mt-4 flex flex-wrap justify-center gap-2 lg:justify-start">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="group inline-flex items-center gap-1.5 rounded-full bg-mist px-3.5 py-2 text-[13px] font-medium text-fg-muted transition-colors duration-200 hover:bg-mist-strong hover:text-fg"
              >
                <span>{s.label}</span>
                <ArrowUpRight
                  size={14}
                  weight="bold"
                  className="opacity-60 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                />
              </a>
            ))
          }
        </div>
      </div>

      {/* Copy + facts */}
      <div data-reveal>
        <p class="eyebrow">
          <span data-lang="en">{en.about.eyebrow}</span>
          <span data-lang="th">{th.about.eyebrow}</span>
        </p>
        <h2 class="headline mt-3 text-[40px] sm:text-[56px]">
          <span data-lang="en">{en.about.title1}</span>
          <span data-lang="th">{th.about.title1}</span>
        </h2>
        <p class="mt-4 max-w-[560px] text-[16px] leading-relaxed text-fg-muted sm:text-[17px]">
          <span data-lang="en">{en.about.desc}</span>
          <span data-lang="th">{th.about.desc}</span>
        </p>

        <dl class="mt-8 grid grid-cols-1 gap-2.5 sm:grid-cols-3">
          {
            facts.map((f) => (
              <div class="rounded-2xl bg-mist px-4 py-3.5">
                <dt class="text-[12px] text-fg-dim">
                  <span data-lang="en">{f.en[0]}</span>
                  <span data-lang="th">{f.th[0]}</span>
                </dt>
                <dd class="mt-1 text-[13px] font-medium text-fg">
                  <span data-lang="en">{f.valueEn}</span>
                  <span data-lang="th">{f.valueTh}</span>
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-2.5 grid grid-cols-1 gap-2.5 sm:grid-cols-3">
          {
            doMini.map((item) => (
              <div class="rounded-2xl bg-mist px-4 py-3.5">
                <p class="truncate text-[12px] font-semibold text-accent">
                  <span data-lang="en">{item.keyEn.split(" · ")[0]}</span>
                  <span data-lang="th">{item.keyTh.split(" · ")[0]}</span>
                </p>
                <p class="mt-1 truncate text-[13px] text-fg-muted">
                  <span data-lang="en">{item.keyEn.split(" · ").slice(1, 3).join(" · ")}</span>
                  <span data-lang="th">{item.keyTh.split(" · ").slice(1, 3).join(" · ")}</span>
                </p>
              </div>
            ))
          }
        </div>

        <div class="mt-8">
          <a href="/about" class="btn-ghost">
            <span data-lang="en">More about me</span>
            <span data-lang="th">เกี่ยวกับผมเพิ่มเติม</span>
            <ArrowUpRight size={16} weight="bold" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
