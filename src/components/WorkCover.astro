---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  monogram: string;
  /** Real cover, either ImageMetadata or public image URL string. */
  cover?: ImageMetadata | string;
  /** Accent mix strength for the CSS cover fallback (e.g. "26%"). */
  accent?: string;
  sizes?: string;
}

const {
  title,
  monogram,
  cover,
  accent = "26%",
  sizes = "(min-width: 640px) 400px, 100vw",
} = Astro.props;

const isMetadata = typeof cover === "object" && cover !== null && "src" in cover;
const isStringUrl = typeof cover === "string" && cover.trim().length > 0;
---

<div class="work-cover-media">
  {
    isMetadata ? (
      <Image
        src={cover as ImageMetadata}
        alt={title}
        widths={[480, 768, 1200]}
        sizes={sizes}
        format="avif"
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    ) : isStringUrl ? (
      <img
        src={cover as string}
        alt={title}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="work-cover" style={`--cover-accent:${accent}`} aria-hidden="true">
        <span class="work-cover__mono">{monogram}</span>
      </div>
    )
  }
</div>
