---
import { PlayIcon as Play, MusicNotesIcon as MusicNotes } from "@phosphor-icons/react";
import { song } from "../content/song.ts";

const hasLyrics = Boolean(song.lyrics?.trim());
const slug = song.title.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<section aria-label="Now playing / กำลังฟัง" class="bg-bg pb-16 sm:pb-20">
  <div class="container-apple">
    <div class="mx-auto max-w-[440px] rounded-2xl bg-mist p-2.5" data-reveal>
      <div class="flex items-center gap-3">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-surface text-fg-dim shadow-[var(--shadow-card)]">
          {
            song.cover ? (
              <img src={song.cover} alt="" class="h-full w-full object-cover" loading="lazy" decoding="async" />
            ) : (
              <MusicNotes size={16} weight="bold" />
            )
          }
        </div>

        <div class="min-w-0 flex-1">
          <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-fg-dim">
            <span data-lang="en">Now playing</span><span data-lang="th">กำลังฟัง</span>
          </p>
          <p id={`song-${slug}`} class="mt-0.5 truncate text-[13px] leading-tight text-fg">
            <span class="font-semibold">{song.title}</span>
            {
              song.artist ? (
                <>
                  <span class="text-fg-dim"> · </span>
                  <span class="text-fg-muted">{song.artist}{song.duration ? ` · ${song.duration}` : ""}</span>
                </>
              ) : song.duration ? (
                <span class="text-fg-muted"> · {song.duration}</span>
              ) : null
            }
          </p>
        </div>

        <span class="eq mr-1 shrink-0" aria-hidden="true"><span></span><span></span><span></span></span>

        {
          song.url && (
            <a
              href={song.url}
              target="_blank"
              rel="noopener"
              aria-label="Listen / ฟังเพลง"
              title="Listen / ฟังเพลง"
              class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent text-white transition-colors duration-200 hover:bg-accent-hover"
            >
              <Play size={14} weight="fill" />
            </a>
          )
        }
      </div>

      {
        hasLyrics && (
          <div class="mt-2 rounded-xl bg-surface p-3.5">
            <div
              class="max-h-36 overflow-y-auto text-[12.5px] leading-relaxed whitespace-pre-line text-fg-muted"
              tabindex="0"
            >
              {song.lyrics}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
