---
import { ArrowUpRightIcon as ArrowUpRight } from "@phosphor-icons/react";
import WorkCover from "./WorkCover.astro";
import { dicts } from "../i18n.ts";
import type { Work } from "../content/work.ts";
import type { DBProject } from "../lib/portfolioData.ts";

interface Props {
  work: Work | DBProject;
  index?: number;
  sizes?: string;
}

const { work: w, index = 0, sizes } = Astro.props;

const en = dicts.en.work;
const th = dicts.th.work;

const accents = ["20%", "28%", "14%", "34%", "24%", "18%"];
const accent = accents[index % accents.length];
const delay = `${Math.min(index * 60, 300)}ms`;
const isLink = Boolean(w.href);
---

<a
  href={w.href}
  target={isLink ? "_blank" : undefined}
  rel={isLink ? "noopener" : undefined}
  class:list={[
    "work-tile group flex h-full flex-col rounded-[28px] bg-mist p-4 outline-none transition-colors duration-300 hover:bg-mist-strong sm:p-5",
  ]}
  style={`transition-delay:${delay}`}
  data-reveal
  data-work-tile
  data-tags={w.categories.join(",")}
>
  <div class="relative overflow-hidden rounded-[20px] bg-surface ring-1 ring-black/[0.06] shadow-[var(--shadow-card)]">
    <div class="work-cover-frame aspect-[16/10]">
      <WorkCover title={w.title} monogram={w.monogram} cover={w.cover} accent={accent} sizes={sizes} />

      {
        w.featured ? (
          <span class="absolute left-3 top-3 rounded-full bg-surface/85 px-2.5 py-1 text-[11px] font-semibold text-fg-muted backdrop-blur">
            <span data-lang="en">{en.featured}</span>
            <span data-lang="th">{th.featured}</span>
          </span>
        ) : null
      }

      {
        isLink ? (
          <span class="pointer-events-none absolute right-3 top-3 grid size-8 place-items-center rounded-full bg-fg/80 text-bg opacity-0 shadow-lg backdrop-blur transition-all duration-300 group-hover:rotate-90 group-hover:opacity-100">
            <ArrowUpRight size={15} weight="bold" />
          </span>
        ) : null
      }
    </div>
  </div>

  <div class="flex flex-1 flex-col px-1 pb-1 pt-5">
    <div class="flex items-center justify-between gap-3 text-[12px] text-fg-dim">
      <span>
        <span data-lang="en">{w.role}</span>
        <span data-lang="th">{w.roleTh}</span>
      </span>
      <span class="tabular-nums">{w.year}</span>
    </div>

    <h3 class="mt-1.5 text-[22px] font-semibold leading-[1.15] tracking-[-0.02em] text-fg sm:text-[24px]">
      {w.title}
    </h3>

    <p class="mt-1.5 max-w-[520px] text-[14px] leading-relaxed text-fg-muted">
      <span data-lang="en">{w.desc}</span>
      <span data-lang="th">{w.descTh}</span>
    </p>

    <div class="mt-auto flex flex-wrap gap-1.5 pt-4">
      {
        w.tags.map((t) => (
          <span class="rounded-full bg-surface px-2.5 py-1 text-[11px] font-medium text-fg-dim">{t}</span>
        ))
      }
    </div>
  </div>
</a>
