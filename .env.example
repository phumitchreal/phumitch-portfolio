# crinoid — environment template
#
# Copy the values you need into `.env.local` (gitignored) for local work, and add
# them in Vercel → Project → Settings → Environment Variables for deployments.
# Apply to Production, Preview and Development so the gate behaves the same everywhere.

# ── Discord (the /studio_lol easter egg) ──────────────────────────────────────
# Bot token with access to the guild. Server side only — never expose it.
DISCORD_BOT_TOKEN=

# ── Cloudflare Turnstile ("verify you are human") ─────────────────────────────
# Create the widget at https://dash.cloudflare.com → Turnstile → Add widget.
#   Widget mode: Managed · Hostnames: phumitch.space, www.phumitch.space (+ localhost to test)
# The sitekey is public and gets inlined into the page; the secret stays on the server.
PUBLIC_TURNSTILE_SITE_KEY=
# Canonical name from the Cloudflare Turnstile flow. `TURNSTILE_SECRET_KEY` also works.
TURNSTILE_SECRET=

# 32+ byte random string used to HMAC-sign the pv_verified cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it invalidates every existing session (visitors just verify again).
TURNSTILE_SESSION_SECRET=

# Optional — override the hostnames accepted from Cloudflare's Siteverify response.
# Defaults to phumitch.space, www.phumitch.space, localhost, 127.0.0.1 (+ *.vercel.app).
# TURNSTILE_ALLOWED_HOSTS=phumitch.space,www.phumitch.space
# Optional — one extra hostname to accept (added on top of the default allowlist).
# TURNSTILE_EXPECTED_HOSTNAME=phumitch.space

# ── Testing the gate end to end without real challenges ──────────────────────
# Cloudflare's dummy keys always pass / always fail from any host, including localhost:
#   sitekey 1x00000000000000000000AA  +  secret 1x0000000000000000000000000000000AA  → always passes
#   sitekey 2x00000000000000000000AB  +  secret 2x0000000000000000000000000000000AA  → always fails
#   sitekey 1x00000000000000000000AA  +  secret 3x0000000000000000000000000000000AA  → "token already spent"
# `pnpm test:turnstile` exercises the endpoints with those keys.